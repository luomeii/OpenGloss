# Preserve locked source bytes across Git checkouts and source archives.
# Frozen Python/JavaScript cores keep LF; existing mixed-EOL files below
# are explicit exceptions, not normalized as part of a release build.
* -text
*.py   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# Batch files already have reviewed LF or CRLF bytes. Preserve both.
*.bat -text
pae/extension/content.js -text
pae/extension/sw.js -text
pae/tests/test_http_write_source.py -text
