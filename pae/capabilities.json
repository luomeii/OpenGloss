        "eval_days": {
          "type": "integer",
          "default": 7
        },
        "evaluate_decisions": {
          "type": "boolean",
          "default": true
        }
      },
      "returns": "{cohort_size, converted, conversion_rate, engagement_rate, median_days_to_known, decision_effects}",
      "http": {
        "method": "POST",
        "path": "/v1/cap/pae.outcomes"
      }
    },
    {
      "name": "pae.familiarity",
      "kind": "observe",
      "status": "implemented",
      "scope": "read",
      "side_effect": "writes_projection",
      "description": "熟悉度投影（35号）：谁会被「无视即熟悉」豁免、为什么；默认 shadow 模式（只记录不生效）",
      "params": {
        "recompute": {
          "type": "boolean",
          "default": true
        },
        "limit": {
          "type": "integer",
          "default": 20
        }
      },
      "returns": "{mode, enforce_active, would_exempt, near_miss, rule_version}",
      "http": {
        "method": "POST",
        "path": "/v1/cap/pae.familiarity"
      }
    },
    {
      "name": "pae.familiarity.restore",
      "kind": "act",
      "status": "implemented",
      "scope": "write",
      "side_effect": "writes_override",
      "description": "一键恢复：让某个词重新被注解（写 revoke 覆盖 + 30 天冷却，尊重人工信号）",
      "params": {
        "lemma": {
          "type": "string",
          "required": true
        }
      },
      "returns": "{restored, cooldown_days}",
      "http": {
        "method": "POST",
        "path": "/v1/cap/pae.familiarity.restore"
      }
    },
    {
      "name": "pae.sensejudge",
      "kind": "act",
      "status": "implemented",
      "scope": "write",
      "side_effect": "calls_llm_and_caches",
      "description": "义项判定（P5 影子期）：对给定词+句子跑一次 LLM 义项判定，**只写缓存与决策日志，不改上屏内容**",
      "params": {
        "lemma": {
          "type": "string"
        },
        "sentence": {
          "type": "string"
        },
        "stats_only": {
          "type": "boolean"
        }
      },
      "returns": "{chosen_idx, baseline_idx, latency_ms, fallback, reason} 或统计",
      "http": {
        "method": "POST",
        "path": "/v1/cap/pae.sensejudge"
      }
    },
    {
      "name": "pae.mute",
      "kind": "act",
      "status": "implemented",
      "scope": "write",
      "side_effect": "toggles_mute",
      "description": "静音开关（读写）：静音时引擎侧主动说话（规则版）与推送一并安静；扩展「静音」按钮经此同步",
      "params": {
        "muted": {
          "type": "boolean"
        }
      },
      "returns": "{muted}",
      "http": {
        "method": "POST",
        "path": "/v1/cap/pae.mute"
      }
    }
  ]
}
