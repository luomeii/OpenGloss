{
  "manifest_version": 3,
  "key": "",
  "name": "OpenGloss",
  "version": "0.4.0",
  "description": "读英文网页时自动标注生词，词汇在阅读里自然积累（本地优先，零遥测）",
  "permissions": ["storage", "scripting"],
  "action": { "default_popup": "popup.html" },
  "host_permissions": ["http://127.0.0.1:4815/*", "<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["character-frame.html"],
    "matches": ["<all_urls>"]
  }],
  "background": { "service_worker": "sw.js" }
}
